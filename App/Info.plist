<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Track</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
    <key>UIBackgroundModes</key>
    <array>
        <string>location</string>
        <string>fetch</string>
        <string>remote-notification</string>
    </array>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchScreenBackground</string>
        <key>UIImageName</key>
        <string>LaunchScreenIcon</string>
    </dict>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
        <string>location-services</string>
        <string>gps</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Track needs access to your location to share it with your circles, even when the app is in the background.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Track needs access to your location to show you on the map and share with your circles.</string>
    <key>NSLocationAlwaysUsageDescription</key>
    <string>Track needs always-on location access to share your location with your circles in the background.</string>
    <!-- Purpose strings for requestTemporaryFullAccuracy(withPurposeKey:). The
         key MUST match LocationService.temporaryAccuracyPurposeKey — iOS
         silently does nothing when it does not, which would leave the "Turn On
         Precise Location" button as dead as the state it is meant to fix. -->
    <key>NSLocationTemporaryUsageDescriptionDictionary</key>
    <dict>
        <key>ShareWithCircle</key>
        <string>Without your precise location Track can only tell your circle roughly which town you are in, so you stop appearing on their map. Allowing it for now puts you back on it.</string>
    </dict>
    <key>NSFaceIDUsageDescription</key>
    <string>Use Face ID to unlock Track and keep your location data secure.</string>
    <key>NSMotionUsageDescription</key>
    <string>Track uses motion data to check your location less often while your phone is sitting still, which saves battery.</string>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.pingolin.track.refresh</string>
    </array>
    <!-- EXPORT COMPLIANCE — answered here so every upload carries the answer.
         The app ships XChaCha20-Poly1305, X25519, Argon2id and BLAKE3 via the
         Rust mobile-sdk: mass-market encryption (ECCN 5D992.c), for which the
         yearly self-classification report to BIS is separate from this flag.

         `false` is what App Store Connect records for these answers to its
         per-build questions: uses encryption: yes; standard algorithms in
         addition to Apple's OS: yes; available in France: no.

         Never set this to `true` without an ITSEncryptionExportComplianceCode
         beside it: with `true` and no approved declaration on the app record,
         altool refuses the upload outright ("Invalid Export Compliance Code",
         iris-code 90592). -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
