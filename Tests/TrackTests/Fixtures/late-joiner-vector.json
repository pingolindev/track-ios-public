{
 "title": "The late-joiner question: the shared vector for the web, iOS and Android clients",
 "source_of_rules": [
  "Track for iOS: LateJoiner.ask()",
  "Track for Android: LateJoiners.case(), questions() and closed()"
 ],
 "copy": {
  "title": "Let {name} into {circle}?",
  "ranOut": "Their invitation ran out before anyone's phone could hand the circle over.",
  "invitedBy": "{inviter} invited them."
 },
 "answers": {
  "letThemIn": "signs a kind-3 admission for the member's id and the keys the question was raised for (the receive-only keys recorded for them / the listed keys); via the waiting-changes path (K3) when this device is behind; an admission from any device closes the question everywhere",
  "notNow": "kept against the invitation; never asked again for it (any case)"
 },
